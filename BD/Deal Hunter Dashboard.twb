  <actions>
    <action caption='Filter1' name='[Action1_AF0A805E47A14602B4ECE72AB241360E]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='DH Dashboard' type='sheet' worksheet='by Discount Band - Top' />
      <link caption='Filter1' delimiter=',' escape='\' expression='tsl:DH%20Dashboard?' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Popular / Front Page Trend - Indiv,WOW performance- Indiv,Daily performance,by Top Level Category,by Thread - Indiv,by Store,by Discount Band - Top,by store % Good/Bad' />
        <param name='on-empty' value='none' />
        <param name='target' value='DH Dashboard' />
      </command>
    </action>
    <action caption='Highlight 1 (generated)' name='[Action2_26E02FA62A044847AAD9F13C6D4A9866]'>
