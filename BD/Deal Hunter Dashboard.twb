              <calculation class='tableau' formula='[Calculation_141019024029487111]/(DATEDIFF(&apos;week&apos;, MIN([Calculation_141019024070352907]), TODAY()) + &#10;IF DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;week&apos;, TODAY()), TODAY()) &gt; 0 THEN &#10;    DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;week&apos;, TODAY()), TODAY()) / 7 &#10;ELSE &#10;    0 &#10;END)' />
