          <datasource-dependencies datasource='sqlproxy.1wr5kkb0mpg4yo11gcjza1q1w40j'>
            <column caption='Discount %' datatype='real' name='[Calculation_141019023989764096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[d_FINAL_PRICE]/[d_LIST_PRICE]' />
            </column>
            <column caption='Discount Band' datatype='string' name='[Calculation_141019023990640641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_141019023989764096] &lt; 0 THEN&#13;&#10;    &apos;less than 00% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0 AND [Calculation_141019023989764096] &lt; 0.09999 THEN&#13;&#10;    &apos;00% to 10% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.10 AND [Calculation_141019023989764096] &lt; 0.19999 THEN&#13;&#10;    &apos;10% to 20% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.20 AND [Calculation_141019023989764096] &lt; 0.29999 THEN&#13;&#10;    &apos;20% to 30% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.30 AND [Calculation_141019023989764096] &lt; 0.39999 THEN&#13;&#10;    &apos;30% to 40% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.40 AND [Calculation_141019023989764096] &lt; 0.49999 THEN&#13;&#10;    &apos;40% to 50% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.50 AND [Calculation_141019023989764096] &lt; 0.59999 THEN&#13;&#10;    &apos;50% to 60% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.60 AND [Calculation_141019023989764096] &lt; 0.69999 THEN&#13;&#10;    &apos;60% to 70% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.70 AND [Calculation_141019023989764096] &lt; 0.79999 THEN&#13;&#10;    &apos;70% to 80% off&apos;&#13;&#10;ELSEIF [Calculation_141019023989764096] &gt;= 0.80 AND [Calculation_141019023989764096] &lt;= 1.0000 THEN&#13;&#10;    &apos;80% to 100% off&apos;&#13;&#10;ELSE&#13;&#10;    &apos;Invalid Discount&apos;&#13;&#10;END' />
            </column>
            <column caption='Popular' datatype='integer' name='[Calculation_141019024029245446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [d_IS_HOT_DEAL] = TRUE THEN [Thread Level] END)' />
            </column>
            <column caption='Frontpage' datatype='integer' name='[Calculation_141019024029487111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [d_IS_FRONT_PAGE_DEAL] = TRUE THEN [Thread Level] END)' />
            </column>
            <column caption='PostDate' datatype='date' name='[Calculation_141019024070352907]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([Thread Post Date Level])' />
            </column>
            <column caption='Conv / Deal' datatype='real' name='[Calculation_3325134331012083712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_TRX_OUTCLICK_ID_dcount]/[m_THREAD_ID_count]' />
            </column>
            <column caption='Clicks / Deal' datatype='real' name='[Calculation_424745801191710723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_OUTCLICK_ID_count]/[m_THREAD_ID_count]' />
            </column>
            <column caption='Avg Net Votes' datatype='real' name='[Calculation_424745801193529348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_THREAD_TOTAL_VOTES_sum]/[m_THREAD_ID_count]' />
            </column>
            <column caption='Views / Deal' datatype='real' name='[Calculation_424745801194389509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_THREAD_POST_VIEWS_sum]/[m_THREAD_ID_count]' />
            </column>
            <column caption='Clicks / Views' datatype='real' name='[Calculation_424745801195433990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_OUTCLICK_ID_count]/[m_THREAD_POST_VIEWS_sum]' />
            </column>
            <column aggregation='Count' caption='Primary Category' datatype='string' default-type='nominal' layered='true' name='[Primary Category]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
