          <datasource-dependencies datasource='sqlproxy.1wr5kkb0mpg4yo11gcjza1q1w40j'>
            <column caption='YTD AVG FP' datatype='real' name='[AVG Deals / Wk (copy)_2199938116959350786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_141019024029487111]/(DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;year&apos;, TODAY()), TODAY()) + 1)' />
            </column>
            <column caption='YTD AVG Popular' datatype='real' name='[AVG FP (copy)_2199938116960178179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_141019024029245446]/(DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;year&apos;, TODAY()), TODAY()) + 1)' />
            </column>
            <column caption='Popular' datatype='integer' name='[Calculation_141019024029245446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [d_IS_HOT_DEAL] = TRUE THEN [Thread Level] END)' />
            </column>
            <column caption='Frontpage' datatype='integer' name='[Calculation_141019024029487111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [d_IS_FRONT_PAGE_DEAL] = TRUE THEN [Thread Level] END)' />
            </column>
            <column caption='% Popular' datatype='real' name='[Calculation_141019024039559176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_141019024029245446]/sum([m_THREAD_ID_count])' />
            </column>
            <column caption='% Frontpage' datatype='real' name='[Calculation_141019024039727113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_141019024029487111]/sum([m_THREAD_ID_count])' />
            </column>
            <column caption='PostDate' datatype='date' name='[Calculation_141019024070352907]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([Thread Post Date Level])' />
            </column>
            <column caption='Current Year' datatype='boolean' name='[Calculation_2199938116956844033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if year(today()) = year([Calculation_141019024070352907]) then true else false end' />
            </column>
            <column caption='% Above' datatype='real' name='[Calculation_3026207908589674497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_4010948112499413015])/sum([m_THREAD_ID_count])' />
            </column>
            <column caption='Conv / Deal' datatype='real' name='[Calculation_3325134331012083712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_TRX_OUTCLICK_ID_dcount]/[m_THREAD_ID_count]' />
            </column>
            <column caption='Conv / Click' datatype='real' name='[Calculation_3519422433715138560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_TRX_OUTCLICK_ID_dcount]/[m_OUTCLICK_ID_count]' />
            </column>
            <column caption='Score' datatype='real' name='[Calculation_4010948112205520898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Thread Level]: sum(ZN([m_THREAD_POST_VIEWS_sum]) + ZN([m_POSTID_count])*756 + ZN([m_THREAD_TOTAL_VOTES_sum])*831 + ZN([m_OUTCLICK_ID_count])*3.48)}' />
            </column>
            <column caption='Above' datatype='integer' name='[Calculation_4010948112499413015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF isnull([Calculation_4010948112205520898]) then 0 ELSEIF [Calculation_4010948112205520898] &gt;= 5874 then 1 else 0 END' />
            </column>
            <column caption='Clicks / Deal' datatype='real' name='[Calculation_424745801191710723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[m_OUTCLICK_ID_count]/[m_THREAD_ID_count]' />
