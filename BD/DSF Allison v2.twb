      <column caption='Count of Hot Deals' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2661908870404890630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[ds_dsf_thread_post (Data.ds_dsf_thread_post)_FF151BBE3B4F47DCA9912B164E3C8002])' />
      </column>
      <column caption='Month-Year' datatype='string' name='[Calculation_3014597003404525568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str (DATEPART(&apos;year&apos;,[dateline])) + &apos; - &apos; +str (DATENAME(&apos;month&apos;,[dateline]) )' />
      </column>
      <column aggregation='Sum' caption='Day of Dateline' datatype='integer' name='[Calculation_3185170840066686976]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='Day([dateline])' />
      </column>
      <column caption='% Above DQS Threshold' datatype='real' name='[Calculation_5151343959336247296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5856860987480457221])/COUNTD([threadid])' />
      </column>
      <column caption='Deal Quality Score (old)' datatype='real' name='[Calculation_5856860987451183106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([views]) * 1 &#10;+ SUM([outclicks]) * 3.48 &#10;+ SUM([replycount]) * 756 &#10;+ SUM([net_votes]) * 842' />
      </column>
      <column caption='Deal Quality Score' datatype='real' name='[Calculation_5856860987454005252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [hot_deals_url] : &#10;    SUM([views]) * 1 &#10;    + SUM([outclicks]) * 3.48 &#10;    + SUM([replycount]) * 756 &#10;    + SUM([net_votes]) * 842&#10;}' />
      </column>
      <column caption='DQS Threshold Count' datatype='integer' name='[Calculation_5856860987480457221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5856860987454005252] &gt;= 5874 THEN 1&#10;ELSE 0&#10;End' />
      </column>
      <column caption='Net Votes ' datatype='integer' default-format='n#,##0;-#,##0' name='[Net Votes (copy)_1573656272633466882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[net_votes]' />
      </column>
      <column caption='Revenue ' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Revenue (copy)_1573656272633290753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[revenue]' />
