          <datasource-dependencies datasource='federated.1cygo3s1gkzmua190u58l0n8x1ek'>
            <column caption='Balance' datatype='real' default-format='C1033%' name='[Balance (Filter) (copy)_151996523553890307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([revenue_amount],0))&#13;&#10;-SUM(IFNULL([payment_amount],0))' />
            </column>
            <column aggregation='Sum' caption='Balance (fixed sum)' datatype='real' default-format='C1033%' name='[Calculation_1347702224260521984]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED&#13;&#10;[dim_merchant_key]&#13;&#10;,[dim_gateway_key]&#13;&#10;,[dim_account_key]&#13;&#10;,[trandate]&#13;&#10;,[transaction_type]&#13;&#10;:&#13;&#10;SUM(IFNULL([revenue_amount],0))&#13;&#10;-SUM(IFNULL([payment_amount],0))&#13;&#10;}' />
            </column>
            <column caption='Row Count' datatype='integer' name='[Calculation_151996523548131328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[_6C60D200ED174D528092B65FF3ECD7DD])' />
            </column>
            <column caption='Snapshot Date Count Distinct' datatype='integer' name='[Calculation_151996523548909569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([snapshot_date])' />
            </column>
            <column caption='Check Number Count Distinct' datatype='integer' name='[Calculation_151996523549036546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([check_number])' />
            </column>
            <column caption='Balance Is Zero' datatype='boolean' name='[Calculation_151996523564027908]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1347702224260521984] = 0&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Revenue Paid %' datatype='real' default-format='p0.00%' name='[Calculation_151996523571851270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//ZN(SUM([Payment Amount])/SUM([Revenue Amount]))&#13;&#10;ZN(SUM([payment_amount]))/SUM([revenue_amount])' />
            </column>
            <column caption='Revenue Unpaid %' datatype='real' default-format='p0.00%' name='[Revenue Paid % (copy)_151996523574341639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//1-(ZN(SUM([Payment Amount])/SUM([Revenue Amount])))&#13;&#10;1-(ZN(SUM([payment_amount]))/SUM([revenue_amount]))' />
            </column>
