                    <relation connection='sqlserver.00na8zh0joqqs11aa1mpk0jz6ngy' name='Custom SQL Query' type='text'>-- BI-1564: Payment Application Reporting (Tableau)&#13;
select&#13;
ds_payment_application_payments_applied_key as ds_key&#13;
,check_number&#13;
,dim_merchant_key&#13;
,dim_gateway_key&#13;
,dim_account_key&#13;
,trandate&#13;
,transaction_type&#13;
,payment_amount&#13;
,case when invoice_id = &apos;-2&apos; then null else invoice_id end as invoice_id&#13;
,paid_date&#13;
,payment_snapshot_date&#13;
,snapshot_date&#13;
,itemline_rate&#13;
,itemline_rate_snapshot&#13;
,snapshot_type&#13;
,cast(is_positive_adj as bit) as is_positive_adj&#13;
,is_snapshot&#13;
,cast(1 as bit) as is_processed&#13;
,case when is_snapshot = 1 then itemline_rate else null end as revenue_amount&#13;
,create_date&#13;
,dss_update_time&#13;
from revenue.dbo.ds_payment_application_payments_applied with(nolock)&#13;
&#13;
union all&#13;
&#13;
select&#13;
ds_payment_application_process_revenue_key as ds_key&#13;
,null as check_number&#13;
,dim_merchant_key&#13;
,dim_gateway_key&#13;
,dim_account_key&#13;
,trandate&#13;
,transaction_type&#13;
,null as payment_amount&#13;
,null as invoice_id&#13;
,null as paid_date&#13;
,null as payment_snapshot_date&#13;
,snapshot_date&#13;
,itemline_rate&#13;
,itemline_rate_snapshot&#13;
,snapshot_type&#13;
,cast(is_positive_adj as bit) as is_positive_adj&#13;
,is_snapshot&#13;
,is_processed&#13;
,case when is_snapshot = 1 then itemline_rate else null end as revenue_amount&#13;
,create_date&#13;
,dss_update_time&#13;
from revenue.dbo.ds_payment_application_process_revenue with(nolock)&#13;
where is_processed = 0</relation>
