    <dashboard name='Payment Application Balance Tracking'>
      <repository-location id='PaymentApplicationBalanceTracking' path='/workbooks/PaymentApplicationReporting' revision='' />
      <style />
      <size maxheight='1654' maxwidth='1654' minheight='1654' minwidth='1654' preset-index='14' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Custom SQL Query+ (Revenue)' name='federated.1cygo3s1gkzmua190u58l0n8x1ek' />
      </datasources>
      <datasource-dependencies datasource='federated.1cygo3s1gkzmua190u58l0n8x1ek'>
        <column aggregation='Sum' caption='Balance (fixed sum)' datatype='real' default-format='C1033%' name='[Calculation_1347702224260521984]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='{ FIXED&#13;&#10;[dim_merchant_key]&#13;&#10;,[dim_gateway_key]&#13;&#10;,[dim_account_key]&#13;&#10;,[trandate]&#13;&#10;,[transaction_type]&#13;&#10;:&#13;&#10;SUM(IFNULL([revenue_amount],0))&#13;&#10;-SUM(IFNULL([payment_amount],0))&#13;&#10;}' />
        </column>
        <column caption='Balance Is Zero' datatype='boolean' name='[Calculation_151996523564027908]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Calculation_1347702224260521984] = 0&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
        </column>
        <column aggregation='Sum' caption='Revenue Paid % (fixed sum)' datatype='real' default-format='p0.00%' name='[Revenue Paid % (copy)_341710658148777985]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='{ FIXED&#13;&#10;[dim_merchant_key]&#13;&#10;,[dim_gateway_key]&#13;&#10;,[dim_account_key]&#13;&#10;,[trandate]&#13;&#10;,[transaction_type]&#13;&#10;:&#13;&#10;//ZN(SUM([Payment Amount])/SUM([Revenue Amount]))&#13;&#10;ZN(SUM([payment_amount]))/SUM([revenue_amount])&#13;&#10;}' />
        </column>
        <column aggregation='Sum' caption='Revenue Unpaid % (fixed sum)' datatype='real' default-format='p0.00%' name='[Revenue Unpaid % (copy)_341710658148900866]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='{ FIXED&#13;&#10;[dim_merchant_key]&#13;&#10;,[dim_gateway_key]&#13;&#10;,[dim_account_key]&#13;&#10;,[trandate]&#13;&#10;,[transaction_type]&#13;&#10;:&#13;&#10;//1-(ZN(SUM([Payment Amount])/SUM([Revenue Amount])))&#13;&#10;1-(ZN(SUM([payment_amount]))/SUM([revenue_amount]))&#13;&#10;}' />
        </column>
        <column caption='Check Number' datatype='string' name='[check_number]' role='dimension' type='nominal' />
